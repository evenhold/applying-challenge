# Mini Onboarding - Variables de entorno
# Copiar a .env: cp .env.example .env

# =============================================================================
# FLOCI (AWS local emulator) - Solo para DESARROLLO LOCAL
# =============================================================================
# En producción, NO se usa AWS_ENDPOINT_URL.
# Lambda usa IAM Role para conectarse a AWS real.
AWS_ENDPOINT_URL=http://floci:4566
AWS_REGION=us-east-1

# =============================================================================
# Credenciales - Solo para DESARROLLO LOCAL
# =============================================================================
# En producción, Lambda ejecuta con IAM Role (sin credenciales en código).
# AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY NO se usan en producción.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4566

# =============================================================================
# SES (email de prueba)
# =============================================================================
SES_SENDER_EMAIL=noreply@mini-onboarding.local
