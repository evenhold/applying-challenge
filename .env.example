# Mini Onboarding - Variables de entorno
# Copiar a .env: cp .env.example .env

# =============================================================================
# FLOCI (AWS local emulator) - Solo para DESARROLLO LOCAL
# =============================================================================
# En producción, NO se usa AWS_ENDPOINT_URL.
# Lambda usa IAM Role para conectarse a AWS real.
AWS_ENDPOINT_URL=http://floci:4566
AWS_REGION=us-east-1

# =============================================================================
# Credenciales - Solo para DESARROLLO LOCAL
# =============================================================================
# En producción, Lambda ejecuta con IAM Role (sin credenciales en código).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# =============================================================================
# DynamoDB
# =============================================================================
DYNAMODB_TABLE=merchants

# =============================================================================
# Auth
# =============================================================================
# AUTH_MOCK=true solo en desarrollo. NUNCA en producción.
AUTH_MOCK=true

# =============================================================================
# Cognito
# =============================================================================
# Estos valores los genera make cognito-setup
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# =============================================================================
# Frontend (NEXT_PUBLIC_* se expone al cliente)
# =============================================================================
# DEV: apunta al proxy de NextJS (same-origin, resuelve CORS)
# PROD: apunta a API Gateway URL (ej. https://api.xxx.execute-api.us-east-1.amazonaws.com)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# DEV: apunta al proxy de NextJS (resuelve CORS con FLOCI)
# PROD: apunta a Cognito directamente (AWS envía CORS headers)
NEXT_PUBLIC_COGNITO_URL=http://localhost:3000/api

# Solo se necesitan si el frontend valida tokens client-side
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-1

# =============================================================================
# Backend (server-side, NO se expone al cliente)
# =============================================================================
# URL del backend para API route proxy (Docker network)
BACKEND_URL=http://backend:3001
# Endpoint de Cognito para API route proxy (Docker network)
COGNITO_ENDPOINT=http://floci:4566

# =============================================================================
# SQS
# =============================================================================
SQS_QUEUE_URL=http://floci:4566/000000000000/merchants-enrichment

# =============================================================================
# SES (email de prueba)
# =============================================================================
SES_SENDER_EMAIL=noreply@mini-onboarding.local
